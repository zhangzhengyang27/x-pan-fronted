    "aplayer": "^1.10.1",
    "artplayer": "^5.4.0",
    "axios": "^1.7.9",
    "js-cookie": "^3.0.5",
    "markdown-it": "^15.0.0",
    "nprogress": "^0.2.0",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^2.3.0",
